function(naidan_set_project_warnings target)
  if(MSVC)
    target_compile_options(${target} PRIVATE /W4)
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
  endif()
endfunction()

function(add_naidan_library target)
  add_library(${target} ${ARGN})
  target_link_libraries(${target} PUBLIC Naidan::Headers)
  naidan_set_project_warnings(${target})
endfunction()

function(add_naidan_tool target)
  add_executable(${target} ${ARGN})
  target_link_libraries(${target} PRIVATE Naidan::Headers)
  naidan_set_project_warnings(${target})
endfunction()
